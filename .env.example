# Copy to .env and edit. Every value here has a working default.

# --- LLM -------------------------------------------------------------
LLM_MODEL=glm-4.7-flash:latest
LLM_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=300
# REQUIRED for hybrid reasoning models on Ollama's OpenAI-compatible
# endpoint. Without "none" the model emits only reasoning tokens and the
# listener hears silence. "low" does NOT disable thinking. Set empty for
# models that reject the parameter.
LLM_REASONING_EFFORT=none

# --- Speech ----------------------------------------------------------
# TINY | MEDIUM | LARGE_V3 | LARGE_V3_TURBO | DISTIL_LARGE_V3 | LARGE_V3_TURBO_Q4
STT_MODEL=LARGE_V3_TURBO_Q4
STT_LANGUAGE=en
TTS_VOICE=af_heart

# --- Turn detection (priority #1) ------------------------------------
# Smart Turn v3 decides when a turn ends. VAD only detects speech presence.
SMART_TURN_STOP_SECS=0.2
SMART_TURN_MAX_DURATION_SECS=8.0
VAD_CONFIDENCE=0.7
VAD_START_SECS=0.2
VAD_STOP_SECS=0.8
# Second-layer defence against being cut off mid-sentence. Costs an extra
# LLM round trip per turn, so measure the baseline before enabling.
TURN_LLM_GATE=false

# --- Memory ----------------------------------------------------------
MEMORY_ENABLED=true
HINDSIGHT_URL=http://localhost:8888/mcp/
HINDSIGHT_BANK=default
MEMORY_RECALL_BUDGET=300
MEMORY_RECALL_TIMEOUT=3.0

# --- Instrumentation -------------------------------------------------
METRICS_ENABLED=true
LOG_DIR=./logs
